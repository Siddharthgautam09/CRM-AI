#!/usr/bin/env sh

branch=$(git rev-parse --abbrev-ref HEAD)
case "$branch" in
  main|master)
    echo "🚫 Direct pushes to '$branch' are blocked — push a feature branch and open a PR instead."
    echo "Emergency override: git push --no-verify"
    exit 1
    ;;
esac

echo "Running pre-push checks (lint + typecheck + test)..."
pnpm validate
