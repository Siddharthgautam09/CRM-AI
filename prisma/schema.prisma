generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Document {
  id        String   @id @default(uuid())
  title     String
  content   String
  ownerId   String   @db.VarChar(50)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
}

// ── modules/platform (Super Admin flow) ─────────────────────────────────────

// Gen_TNT tracks infra-provisioning status (PROVISIONING/ACTIVE/SUSPENDED/...);
// this tracks the separate "has the owner accepted their invite yet?"
// business state the console actually shows (PENDING vs Active) — updated to
// ACTIVE by the webhook modules/auth calls after a TENANT_ADMIN invite is
// accepted. See modules/platform/brokerage.service.ts.
model BrokerageOnboarding {
  tenantId     String   @id
  invitationId String
  status       String   @default("PENDING") // PENDING | ACTIVE
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// Deliberately simple (a plain table, not the full Gen_Audit hash-chained
// ledger service) — see project decision log. Swappable later without an API
// change: same shape a "real" audit consumer would read off the
// platform.audit exchange.
model ActivityLog {
  id         String   @id @default(uuid())
  actorId    String?
  action     String
  targetType String?
  targetId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([action])
  @@index([createdAt])
}

model BrokerageExportJob {
  id          String    @id @default(uuid())
  tenantId    String
  status      String    @default("EXPORTING") // EXPORTING | READY | FAILED | EXPIRED | DELETED
  filePath    String?
  requestedAt DateTime  @default(now())
  readyAt     DateTime?
  expiresAt   DateTime?
  deletedAt   DateTime?

  @@index([tenantId])
}

// Backs AiCostLimitProvider (implements Gen_USG's ILimitProvider). A present,
// unexpired row means "Allow extra for today" was clicked — getLimits()
// returns AI_COST_OVERRIDE_LIMIT instead of AI_COST_DAILY_LIMIT until
// expiresAt, then it reverts on its own ("resets by itself tomorrow"), no
// cleanup job needed.
model AiCostLimitOverride {
  tenantId  String   @id
  expiresAt DateTime
  updatedAt DateTime @updatedAt
}

// ── modules/crm (Team Lead / Broker flow — Flow 3, and now Flow 4's core) ──

// "Lead" vs "Client" is just this same stage field — NEW..APPROVED are
// leads, FUNDED is a client, LOST is neither — not a separate table, so a
// funding doesn't require moving a row between models.
enum LeadStage {
  NEW
  QUALIFIED
  APPLICATION
  UNDERWRITING
  APPROVED
  FUNDED
  LOST
}

model Lead {
  id           String    @id @default(uuid())
  tenantId     String
  brokerUserId String
  name         String
  email        String?
  phone        String?
  stage        LeadStage @default(NEW)
  lostReason   String?
  // "New client" form fields (Flow 4.1) — single-applicant scope, no
  // co-applicant modeling (that's a bigger schema than this CRM core needs).
  income          Float?
  monthlyDebts    Float?
  downPayment     Float?
  propertyAddress String?
  propertyValue   Float?
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  tasks           Task[]
  mortgages       Mortgage[]

  // No teamId column: "which team is this lead's broker on" is resolved live
  // against modules/auth (the source of truth for team membership) rather
  // than denormalized here, so a broker moving teams can never leave a stale
  // team_id behind on their leads — see modules/crm/modauth.client.ts.
  @@index([tenantId])
  @@index([brokerUserId])
  @@index([stage])
}

// "Change the stage to Funded" cannot be skipped without one of these (see
// lead.service.ts's fundLead) — a client can hold more than one, each with
// its own lender and dates, hence a separate table rather than fields on Lead.
model Mortgage {
  id             String   @id @default(uuid())
  leadId         String
  lender         String
  interestRate   Float
  balance        Float
  monthlyPayment Float
  maturityDate   DateTime
  createdAt      DateTime @default(now())
  lead           Lead     @relation(fields: [leadId], references: [id])

  @@index([leadId])
  @@index([maturityDate])
}

model Task {
  id           String    @id @default(uuid())
  tenantId     String
  brokerUserId String
  leadId       String?
  title        String
  dueDate      DateTime?
  completed    Boolean   @default(false)
  createdAt    DateTime  @default(now())
  lead         Lead?     @relation(fields: [leadId], references: [id])

  @@index([tenantId])
  @@index([brokerUserId])
  @@index([leadId])
}
